{
  "name": "shotviva",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:schema": "tsx scripts/db-schema.ts",
    "import:prompts": "tsx --env-file-if-exists=.env.local scripts/import-prompts.ts",
    "qa:accounts": "tsx --env-file=.env.local scripts/qa/accounts.ts",
    "qa:login": "tsx --env-file=.env.local scripts/qa/login.ts",
    "qa:reset": "tsx --env-file=.env.local scripts/qa/reset.ts",
    "seo:check": "tsx scripts/seo-check.ts",
    "check:app-shell": "tsx scripts/app-shell-check.ts",
    "seo:ssr": "tsx --require ./scripts/ci/ignore-css.cjs scripts/ssr-seo-audit.ts",
    "js:budget": "tsx scripts/js-budget.ts",
    "eval:identity": "tsx --conditions=react-server scripts/identity-judge-eval.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/s3-request-presigner": "^3.1162.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@sentry/nextjs": "11.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "next-intl": "^4.14.9",
    "posthog-js": "1.438.21",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "23.0.1",
    "tailwind-merge": "^3.7.0",
    "vaul": "1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  }
}
