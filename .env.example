# Names only. Real values live in Vercel project settings and a local .env.local (gitignored).
# Every variable is parsed in src/core/env.ts (server) or src/core/public-env.ts (client);
# each task card that needs a new variable adds it there and here in the same PR.

NEXT_PUBLIC_SITE_URL=
# Controls the catalogue baked into this build. Unset keeps v1. Run pricing:prepromote against the target DB before promoting.
NEXT_PUBLIC_PRICING_CATALOG_VERSION=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_HCAPTCHA_SITEKEY=
# The hCaptcha secret Supabase Auth also holds; the business inquiry form (T86) checks tokens with it.
HCAPTCHA_SECRET=

# Vercel sets VERCEL_ENV itself; set it locally only to mimic production.
VERCEL_ENV=
# Cloudflare R2: private bucket per environment (preview and production are separate buckets).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket for template covers only (covers/ prefix): shotviva-assets-preview in preview,
# shotviva-assets in production. Same account and keys as R2_BUCKET.
R2_PUBLIC_BUCKET=
# Covers are read from the site's own /assets (ARCHITECTURE §8.3, T51): next.config rewrites
# /assets/* to R2_PUBLIC_ORIGIN (the public bucket's r2.dev origin, https, no trailing slash,
# read at build) and caches it for a year. Production: NEXT_PUBLIC_ASSETS_BASE_URL=
# Image CDN switch (Tencent EdgeOne): cover srcsets use <this>/_next/image?… instead of the site's
# own /_next/image. Production: https://img-eo.shotviva.com (the CDN forwards only /_next/image
# to shotviva.com). Unset = off; read at build, so changing it needs a redeploy.
NEXT_PUBLIC_IMAGE_CDN_URL=
# https://shotviva.com/assets. Preview may point NEXT_PUBLIC_ASSETS_BASE_URL straight at the
# r2.dev origin. R2_PUBLIC_ORIGIN is required when the base URL is the site's own /assets.
R2_PUBLIC_ORIGIN=
NEXT_PUBLIC_ASSETS_BASE_URL=
# OpenAI Images fallback, used only while no provider is active in /admin/providers (ARCHITECTURE §3.3).
# Model defaults to gpt-image-2.5-sunburst.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
# Yuan per US dollar for CNY-billed image providers (Volcano Engine Ark). Default 6.72 (PBOC parity 2026-11-09).
CNY_PER_USD=
# OpenRouter management key, used only by /admin/costs to read daily billed usage. Optional.
OPENROUTER_MANAGEMENT_KEY=
# Stripe (server only, never NEXT_PUBLIC_). Test-mode keys in Preview and local, live keys only in
# Production. Webhook secret = the signing secret of the endpoint registered for that environment.
# STRIPE_MANAGED_PAYMENTS defaults to on; set off only while live Managed Payments awaits approval.
# STRIPE_WECHAT_PAY defaults to off (Alipay alone); set on once Stripe has approved WeChat Pay (T73).
# Prices are found by lookup_key (scripts/stripe-setup.ts creates them), so no Price id variables.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MANAGED_PAYMENTS=
STRIPE_WECHAT_PAY=
# T82: on = Checkout requires ticking the Terms of Service box (dispute evidence). Default off; turn
# on only after the Terms URL is set in Stripe Settings → Business details → Public details.
STRIPE_TERMS_CONSENT=
# Payment channel (T13): stripe (default) or waffo. On Waffo a card membership auto-renews, Alipay
# buys one period and packs are one-time (T50); switching is a manual env change plus a redeploy. With waffo, every WAFFO_* key below is required.
PAYMENT_CHANNEL=
# Waffo (server only). WAFFO_ENVIRONMENT is test everywhere but Production (prod is refused
# elsewhere). The private key belongs to an API key of that environment; the webhook public key is
# Waffo's verification key for it (Dashboard → Settings → Webhooks). WAFFO_PRODUCT_IDS is one-line
# JSON mapping all nine product ids to Waffo one-time products: {"starter_monthly":"PROD_…",…}.
# WAFFO_SUBSCRIPTION_PRODUCT_IDS maps the six memberships to Waffo subscription products (card
# checkouts, T50): {"starter_monthly":"PROD_…",…}. A missing id in either map fails start-up.
WAFFO_ENVIRONMENT=
WAFFO_MERCHANT_ID=
WAFFO_STORE_ID=
WAFFO_PRIVATE_KEY=
WAFFO_WEBHOOK_PUBLIC_KEY=
WAFFO_PRODUCT_IDS=
WAFFO_SUBSCRIPTION_PRODUCT_IDS=
# Wishlist (T12, T62): on opens the wishlist on a preview or local deployment even while the admin
# switch on /admin/features is off. Ignored in Production, which follows the admin switch only.
FEATURE_WISHLIST_PREVIEW=
# PostHog (US cloud, cookieless). The project key is public by design; empty turns analytics off.
# The host defaults to https://us.i.posthog.com when unset.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
# /admin/analytics 「流量与转化」 (T74): server-only. A PostHog personal API key with only the
# Query Read permission, scoped to this project, and the project id (712352). Unset → the page
# shows how to configure them instead of numbers.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# Admin-only CDN request statistics. Use a Vercel credential authorized to read Observability
# for this project and its team. No credentials are needed to show the unavailable state.
VERCEL_OBSERVABILITY_TOKEN=
VERCEL_OBSERVABILITY_PROJECT_ID=
VERCEL_OBSERVABILITY_TEAM_ID=
# Optional private JSON from scripts/analytics/refresh-edge-snapshot.mjs for dated fallback.
VERCEL_OBSERVABILITY_SNAPSHOT=
# Sentry, written by Vercel's Sentry integration (Production + Preview). Without the DSN Sentry
# is a no-op everywhere. Token, org and project are build-time only (source-map upload in
# next.config.ts); without the token the upload is skipped. The integration's other variables
# (SENTRY_PUBLIC_KEY, SENTRY_OTLP_TRACES_URL, SENTRY_VERCEL_LOG_DRAIN_URL) are not read by the app.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Mainland China phone sign-in (T63; Chinese pages only). Supabase makes and checks the code; its
# "Send SMS" Auth Hook posts it to /api/auth/sms-hook, which checks the hook signature and the
# limits, then hands it to the adapter SMS_PROVIDER names: fake (sends nothing; previews, local,
# tests; refused in Production) or aliyun. Unset → the hook answers 503 and no code goes out.
# SEND_SMS_HOOK_SECRET is the secret Supabase shows for that hook (v1,whsec_…), one per project.
SMS_PROVIDER=
SEND_SMS_HOOK_SECRET=
# Alibaba Cloud Phone Number Verification Service, SMS verification (SMS_PROVIDER=aliyun, Dypnsapi
# SendSmsVerifyCode): a RAM user's AccessKey allowed only to send SMS verification codes, the
# gifted signature name from the console and its paired template code (variables `code`, `min`).
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# Owner business alerts (T72, ARCHITECTURE §16.4): plain-Chinese messages (refunds, disputes, payments
# that did not land, generation failure spikes, new tickets, upgrade cancel failures) posted to a
# Feishu group's custom bot with 签名校验 on. Both or neither: unset sends nothing (previews by
# default; point a preview at a test group to validate). Values live in the password manager only.
FEISHU_ALERT_WEBHOOK_URL=
FEISHU_ALERT_SECRET=
