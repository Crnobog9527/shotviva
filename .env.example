# Names only. Real values live in Vercel project settings and a local .env.local (gitignored).
# Every variable is parsed in src/core/env.ts (server) or src/core/public-env.ts (client);
# each task card that needs a new variable adds it there and here in the same PR.

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_HCAPTCHA_SITEKEY=

# Vercel sets VERCEL_ENV itself; set it locally only to mimic production.
VERCEL_ENV=
# Cloudflare R2: private bucket per environment (preview and production are separate buckets).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# OpenAI GPT-Image-2.5. Model defaults to gpt-image-2.5-sunburst; gpt-image-2.5-flare is the faster one.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
# PostHog (US cloud, cookieless). The project key is public by design; empty turns analytics off.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Sentry. Without the DSN Sentry is a no-op everywhere. The auth token, org and project are
# build-time only (source map upload in next.config.ts); without the token the upload is skipped.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
