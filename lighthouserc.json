{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/ci/lighthouse-server.mjs",
      "startServerReadyPattern": "Lighthouse proxy ready",
      "url": [
        "https://localhost:3443/",
        "https://localhost:3443/zh",
        "https://localhost:3443/pricing",
        "https://localhost:3443/zh/pricing",
        "https://localhost:3443/image-to-image-generator",
        "https://localhost:3443/commercial-photography"
      ],
      "numberOfRuns": 3,
      "settings": { "onlyCategories": ["performance"], "chromeFlags": "--no-sandbox --headless=new --ignore-certificate-errors" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85, "aggregationMethod": "median-run" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500, "aggregationMethod": "median-run" }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200, "aggregationMethod": "median-run" }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
